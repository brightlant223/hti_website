[Unit]
Description=HTI Website FastAPI backend
After=network.target

[Service]
Type=simple
User=hti
Group=hti
WorkingDirectory=/var/www/hti_website/backend
EnvironmentFile=/var/www/hti_website/backend/.env
ExecStart=/var/www/hti_website/.venv/bin/uvicorn main:app --host 127.0.0.1 --port 8000
Restart=on-failure
RestartSec=5
UMask=0027

[Install]
WantedBy=multi-user.target
